# OPTIONAL. The dashboard works with NO secrets as long as the Google Sheet is
# shared "Anyone with the link – Viewer" (it is today).
#
# Use this only if the sheet is made private later. Then:
#   1. share the sheet with the service-account e-mail as Viewer,
#   2. paste this file's contents (with your real key) into
#      Streamlit Community Cloud → App → Settings → Secrets.
# Never commit a real secrets.toml to GitHub.

[app_settings]
data_source = "api"                      # "csv" (default, public link) or "api" (service account)
# sheet_id = "1fJjKezE5Dujuc_QTmtwefe6z2h8ff-E3QuOO49Yjd1g"
# gid = "1371427582"
display_timezone = "Asia/Kolkata"
timestamp_order = "monthfirst"           # the logger writes month/day/year (11/4/2026 = 4 Nov)

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "0123456789abcdef0123456789abcdef01234567"
private_key = "-----BEGIN PRIVATE KEY-----\nPASTE-YOUR-PRIVATE-KEY-HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
